{
  "name": "golang-bible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-search-index.mjs && next build",
    "start": "next start",
    "validate": "node scripts/validate-content.mjs",
    "search-index": "node scripts/build-search-index.mjs",
    "lint-mdx": "node scripts/lint-mdx.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm validate && pnpm lint-mdx && pnpm verify:snippets",
    "verify:snippets": "node scripts/test-snippets.mjs --strict",
    "verify:modules": "node scripts/test-snippets.mjs --strict --with-modules",
    "verify:vet": "node scripts/test-snippets.mjs --strict --vet --with-modules",
    "snippets:report": "node scripts/test-snippets.mjs --report-only",
    "audit:versions": "node scripts/audit-version-claims.mjs"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "next-mdx-remote": "5.0.0",
    "gray-matter": "4.0.3",
    "remark-gfm": "4.0.1",
    "rehype-slug": "6.0.0",
    "rehype-pretty-code": "0.14.1",
    "shiki": "1.29.2",
    "github-slugger": "2.0.0"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3"
  }
}
