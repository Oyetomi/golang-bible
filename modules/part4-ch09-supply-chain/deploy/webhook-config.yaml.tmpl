apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingWebhookConfiguration
metadata:
  name: image-policy
webhooks:
  - name: image-policy.example.com
    admissionReviewVersions: ["v1"]
    sideEffects: None
    failurePolicy: Fail          # if the webhook is down, pods are refused, not waved through
    timeoutSeconds: 10
    namespaceSelector:
      matchLabels: {verify-images: enabled}
    rules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["pods"]
    clientConfig:
      service: {name: image-policy, namespace: default, path: /validate}
      caBundle: @@CABUNDLE@@
